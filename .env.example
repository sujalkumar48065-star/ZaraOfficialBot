# Telegram and owner/admin access
ZARA_BOT_TOKEN=put-in-secure-env
ZARA_OWNER_ID=8799679469
ZARA_ADMIN_IDS=8799679469
ZARA_UPDATE_CHANNEL=
ZARA_UPDATE_CHANNEL_URL=https://t.me/+HjHouGnrhjNlZTA1
ZARA_UPDATE_CHAT_ID=-1004395250570
ZARA_UPDATE_CHANNEL_LABEL=Zara Updates
ZARA_SUPPORT_USERNAME=Tilx1
ZARA_DEVELOPER_USERNAME=Tilx1

# Optional premium links. Leave empty to hide them from the bot.
ZARA_PAYMENT_URL=
ZARA_POLICY_URL=

# AI and media providers (optional)
XAI_API_KEY=put-in-secure-env
XAI_MODEL=grok-4
XAI_BASE_URL=https://api.x.ai/v1
OPENROUTER_API_KEY=put-in-secure-env
OPENAI_API_KEY=optional-fallback
GIPHY_API_KEY=optional
# Nekos.best anime GIFs are public and need no API key.
ZARA_NEKOS_ENABLED=1
ZARA_NEKOS_USER_AGENT=ZaraOfficialBot (https://github.com/sujalkumar48065-star/ZaraOfficialBot)
# ZARA_NEKOS_TIMEOUT=6
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
ZARA_AI_NAME_TRIGGERS=zara,zarra,zaara,mee,zarabot,meezara,meezarabot
ZARA_AI_QUIET_TRIGGERS=stop,chup,shut up,chup hoja,chup ho ja,be quiet
ZARA_REMOTE_GIFS=0

# Local SQLite path (ignored by git)
ZARA_DB_PATH=data/zara.sqlite3

# Verification Mini App. Set this to the deployed HTTPS URL.
ZARA_VERIFY_WEBAPP_URL=
# Optional keep-alive for the deployed Mini App web service.
ZARA_SELF_PING_URL=
ZARA_SELF_PING_INTERVAL=240
ZARA_SELF_PING_DELAY=30

# Storage backend: sqlite (default) or mysql (TiDB Cloud uses mysql).
ZARA_DB_BACKEND=sqlite
# Full TiDB/MySQL URL. Prefer this over the discrete fields below.
# ZARA_DB_URL=mysql://user.prefix:password@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/zara?ssl=true
# ZARA_DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
# ZARA_DB_PORT=4000
# ZARA_DB_USER=user.prefix
# ZARA_DB_PASSWORD=
# ZARA_DB_NAME=zara
# ZARA_DB_SSL=required
# ZARA_DB_SSL_CA=/etc/secrets/tidb-ca.pem
# ZARA_DB_POOL_SIZE=5
# ZARA_DB_MAX_OVERFLOW=5
# ZARA_DB_POOL_RECYCLE=240
# ZARA_DB_POOL_TIMEOUT=30
# ZARA_DB_CONNECT_TIMEOUT=10
# ZARA_DB_READ_TIMEOUT=30
# ZARA_DB_WRITE_TIMEOUT=30
# ZARA_DB_RETRIES=3
# ZARA_DB_RETRY_DELAY=0.25

# Encrypt sensitive columns and exports. Back this key up separately.
# Generate with: python -m zara.db.cli init-key
# ZARA_ENCRYPTION_KEY=

# Backups and one-time legacy SQLite migration
# ZARA_BACKUP_DIR=backups
# ZARA_LEGACY_DB_PATH=data/zara.sqlite3
# ZARA_AUTO_MIGRATE_LEGACY=0
